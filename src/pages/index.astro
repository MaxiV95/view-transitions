---
import Layout from "@layouts/Layout.astro";
---

<Layout title="View Transitions">
  <div class="min-h-screen flex items-center justify-center">
    <a transition:name={`Next`} class="btn bg-gray-500" href="/1">Start</a>
  </div>
</Layout>

<style>
  @reference "tailwindcss";
  .btn {
    @apply text-white
    text-center
    no-underline
    m-4 p-4
    rounded-md
    hover:brightness-125
    transition;
  }
</style>
