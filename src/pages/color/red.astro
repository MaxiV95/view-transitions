---
import Layout from "@layouts/Layout.astro";
---

<Layout title="View Transitions">
  <div class="min-h-screen flex items-center justify-center">
    <a transition:name={`Prev`} class="btn bg-gray-500" href="/color/blue">Prev</a>
    <a transition:name={`Red`} class="btn bg-red-500" href="/">Red</a>
    <a transition:name={`Next`} class="btn bg-gray-500" href="/color/yellow">Next</a>
  </div>
</Layout>

<style>
  @reference "tailwindcss";
  .btn {
    @apply text-white 
    text-center 
    no-underline 
    m-4 p-12 
    rounded-md
    hover:brightness-125
    transition;
  }
</style>
