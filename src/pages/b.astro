---
import Layout from "@layouts/Layout.astro";
---

<Layout title="View Transitions">
  <div class="min-h-screen flex flex-col items-center justify-center">
    <h2>3</h2>
    <div class="grid grid-cols-2 gap-4 w-fit">
      <a transition:name={`Yellow`} class="btn bg-yellow-500" href="/color/yellow">Yellow</a>
      <a transition:name={`Green`} class="btn bg-green-500" href="/color/green">Green</a>
      <a transition:name={`Red`} class="btn bg-red-500" href="/color/red">Red</a>
      <a transition:name={`Blue`} class="btn bg-blue-500" href="/color/blue">Blue</a>
      <a transition:name={`Prev`} class="btn bg-gray-500" href="/a">Prev</a>
      <a transition:name={`Next`} class="btn bg-gray-500" href="/c">Next</a>
    </div>
  </div>
</Layout>

<style>
  @reference "tailwindcss";
  .btn {
    @apply text-white 
    text-center 
    no-underline 
    m-4 p-6 
    rounded-md
    hover:brightness-125
    transition;
  }
</style>
