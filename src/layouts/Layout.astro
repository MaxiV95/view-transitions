---
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  image?: string;
  description?: string;
}

const { title, image, description } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <meta name="generator" content={Astro.generator} />
    <!-- SEO -->
    <meta name="description" content={description ?? "Pokemon Static"} />
    <meta name="author" content={"Maxi"} />
    <!-- OG Meta Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description ?? "Pokemon Static"} />
    <meta property="og:image" content={image ?? `${base}favicon.svg`} />
    <!-- Required -->
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  @import "tailwindcss";
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
